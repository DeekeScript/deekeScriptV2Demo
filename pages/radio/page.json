{
  "title": {
    "text": "单选",
    "fontSize": 18,
    "color": "#FFFFFF",
    "background": "#006A65"
  },
  "style": {
    "background": "#F5F5F5",
    "padding": 12
  },
  "body": [
    { "type": "notice", "text": "pages/radio/page.js" },
    { "type": "notice", "text": "值为当前选中项的 value。" },
    { "type": "space", "height": 8 },
    {
      "type": "card",
      "children": [
        {
          "type": "radio",
          "name": "mode",
          "label": "运行模式",
          "options": [
            { "label": "稳妥", "value": "safe" },
            { "label": "均衡", "value": "normal" },
            { "label": "激进", "value": "fast" }
          ],
          "value": "safe"
        },
        { "type": "notice", "text": "当前：{{mode}}" }
      ]
    },
    { "type": "space", "height": 8 },
    {
      "type": "card",
      "children": [
        { "type": "text", "text": "自定义颜色", "style": { "fontWeight": "bold" } },
        {
          "type": "radio",
          "name": "tone",
          "label": "蓝色单选",
          "style": { "color": "#1565C0" },
          "options": [
            { "label": "蓝", "value": "blue" },
            { "label": "对照", "value": "other" }
          ],
          "value": "blue"
        }
      ]
    }
  ]
}
