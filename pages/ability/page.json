{
  "title": {
    "text": "能力",
    "fontSize": 18,
    "color": "#FFFFFF",
    "background": "#006A65"
  },
  "style": {
    "padding": 10,
    "background": "#F5F5F5"
  },
  "body": [
    { "type": "notice", "text": "这些不是 body 里的 type。下拉刷新写在 page.json 根上；悬浮球是系统 overlay；底部菜单写在入口 bottomMenus。" },
    { "type": "space", "height": 8 },
    {
      "type": "list",
      "bind": "items",
      "item": {
        "type": "card",
        "action": { "type": "{{item.mode}}", "page": "{{item.page}}" },
        "children": [
          {
            "type": "row",
            "style": { "gap": 8 },
            "children": [
              { "type": "text", "text": "{{item.name}}", "style": { "weight": 1, "fontWeight": "bold" } },
              { "type": "notice", "text": "{{item.desc}}" }
            ]
          }
        ]
      }
    }
  ]
}
