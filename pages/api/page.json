{
  "title": {
    "text": "接口",
    "fontSize": 18,
    "color": "#FFFFFF",
    "background": "#006A65"
  },
  "style": {
    "padding": 10,
    "background": "#F5F5F5"
  },
  "body": [
    {
      "type": "notice",
      "text": "按文档模块分组。节点/图色需对应权限。Cos、Socket.IO、Device Owner、Hid 需自备密钥、服务或硬件。"
    },
    {
      "type": "space",
      "height": 8
    },
    {
      "type": "text",
      "text": "节点与手势",
      "style": {
        "fontWeight": "bold"
      }
    },
    {
      "type": "list",
      "bind": "node",
      "item": {
        "type": "card",
        "action": {
          "type": "navigate",
          "page": "{{item.page}}"
        },
        "children": [
          {
            "type": "row",
            "style": {
              "gap": 8
            },
            "children": [
              {
                "type": "text",
                "text": "{{item.name}}",
                "style": {
                  "weight": 1,
                  "fontWeight": "bold"
                }
              },
              {
                "type": "notice",
                "text": "{{item.desc}}"
              }
            ]
          }
        ]
      }
    },
    {
      "type": "space",
