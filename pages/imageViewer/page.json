{
  "title": {
    "text": "图片查看器",
    "fontSize": 18,
    "color": "#FFFFFF",
    "background": "#006A65"
  },
  "style": { "background": "#F5F5F5", "padding": 12 },
  "body": [
    { "type": "notice", "text": "pages/imageViewer/page.js" },
    { "type": "notice", "text": "点头像或图片即可全屏查看，点空白处关闭。" },
    { "type": "space", "height": 8 },
    {
      "type": "row",
      "style": { "gap": 12 },
      "children": [
        { "type": "avatar", "src": "img/avatar-1.jpg", "size": 56, "value": 0, "onTap": "onOpen" },
        { "type": "avatar", "src": "img/avatar-2.jpg", "size": 56, "value": 1, "onTap": "onOpen" },
        { "type": "avatar", "src": "img/avatar-3.jpg", "size": 56, "value": 2, "onTap": "onOpen" },
        { "type": "avatar", "src": "img/avatar-4.jpg", "size": 56, "value": 3, "onTap": "onOpen" }
      ]
    },
    { "type": "space", "height": 8 },
    { "type": "button", "text": "打开查看器", "onTap": "onOpen" },
    {
      "type": "imageViewer",
      "showIf": "open",
      "index": "{{index}}",
      "urls": ["img/avatar-1.jpg", "img/avatar-2.jpg", "img/avatar-3.jpg", "img/avatar-4.jpg"]
    }
  ]
}
