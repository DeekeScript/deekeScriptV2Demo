{
  "title": {
    "text": "组件",
    "fontSize": 18,
    "color": "#FFFFFF",
    "background": "#006A65"
  },
  "style": {
    "padding": 10,
    "background": "#F5F5F5"
  },
  "body": [
    { "type": "notice", "text": "点一行打开对应示例页。" },
    { "type": "space", "height": 8 },
    { "type": "text", "text": "基础组件", "style": { "fontWeight": "bold" } },
    {
      "type": "list",
      "bind": "basics",
      "item": {
        "type": "card",
        "action": { "type": "navigate", "page": "{{item.page}}" },
        "children": [
          {
            "type": "row",
            "style": { "gap": 8 },
            "children": [
              { "type": "text", "text": "{{item.name}}", "style": { "weight": 1, "fontWeight": "bold" } },
              { "type": "notice", "text": "{{item.desc}}" }
            ]
          }
        ]
      }
    },
    { "type": "space", "height": 8 },
    { "type": "text", "text": "表单与列表", "style": { "fontWeight": "bold" } },
    {
      "type": "list",
      "bind": "forms",
      "item": {
        "type": "card",
        "action": { "type": "navigate", "page": "{{item.page}}" },
        "children": [
          {
            "type": "row",
            "style": { "gap": 8 },
            "children": [
              { "type": "text", "text": "{{item.name}}", "style": { "weight": 1, "fontWeight": "bold" } },
              { "type": "notice", "text": "{{item.desc}}" }
            ]
          }
        ]
      }
    },
    { "type": "space", "height": 8 },
    { "type": "text", "text": "布局与页面", "style": { "fontWeight": "bold" } },
    {
      "type": "list",
      "bind": "layouts",
      "item": {
        "type": "card",
        "action": { "type": "navigate", "page": "{{item.page}}" },
        "children": [
          {
            "type": "row",
            "style": { "gap": 8 },
            "children": [
              { "type": "text", "text": "{{item.name}}", "style": { "weight": 1, "fontWeight": "bold" } },
              { "type": "notice", "text": "{{item.desc}}" }
            ]
          }
        ]
      }
    }
  ]
}
