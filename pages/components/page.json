{
  "title": {
    "text": "组件",
    "fontSize": 18,
    "color": "#FFFFFF",
    "background": "#006A65"
  },
  "style": {
    "padding": 10,
    "background": "#F5F5F5"
  },
  "body": [
    { "type": "space", "height": 8 },
    { "type": "text", "text": "展示", "style": { "fontWeight": "bold" } },
    { "type": "notice", "text": "文案、标签、角标、图片、网页、空状态" },
    {
      "type": "list",
      "bind": "display",
      "item": {
        "type": "card",
        "action": { "type": "navigate", "page": "{{item.page}}" },
        "children": [
          {
            "type": "row",
            "style": { "gap": 8 },
            "children": [
              { "type": "text", "text": "{{item.name}}", "style": { "weight": 1, "fontWeight": "bold" } },
              { "type": "notice", "text": "{{item.desc}}" }
            ]
          }
        ]
      }
    },
    { "type": "space", "height": 8 },
    { "type": "text", "text": "表单", "style": { "fontWeight": "bold" } },
    { "type": "notice", "text": "每个组件单独一页，综合拼装见最后一项" },
    {
      "type": "list",
      "bind": "forms",
      "item": {
        "type": "card",
        "action": { "type": "navigate", "page": "{{item.page}}" },
        "children": [
          {
            "type": "row",
            "style": { "gap": 8 },
            "children": [
              { "type": "text", "text": "{{item.name}}", "style": { "weight": 1, "fontWeight": "bold" } },
              { "type": "notice", "text": "{{item.desc}}" }
            ]
          }
        ]
      }
    },
    { "type": "space", "height": 8 },
    { "type": "text", "text": "结构", "style": { "fontWeight": "bold" } },
    { "type": "notice", "text": "列表、宫格、选项卡、弹层、加载" },
    {
      "type": "list",
      "bind": "structure",
      "item": {
        "type": "card",
        "action": { "type": "navigate", "page": "{{item.page}}" },
        "children": [
          {
            "type": "row",
            "style": { "gap": 8 },
            "children": [
              { "type": "text", "text": "{{item.name}}", "style": { "weight": 1, "fontWeight": "bold" } },
              { "type": "notice", "text": "{{item.desc}}" }
            ]
          }
        ]
      }
    },
    { "type": "space", "height": 8 },
    { "type": "text", "text": "页面", "style": { "fontWeight": "bold" } },
    { "type": "notice", "text": "整页布局和顶栏示例" },
    {
      "type": "list",
      "bind": "pages",
      "item": {
        "type": "card",
        "action": { "type": "navigate", "page": "{{item.page}}" },
        "children": [
          {
            "type": "row",
            "style": { "gap": 8 },
            "children": [
              { "type": "text", "text": "{{item.name}}", "style": { "weight": 1, "fontWeight": "bold" } },
              { "type": "notice", "text": "{{item.desc}}" }
            ]
          }
        ]
      }
    }
  ]
}
