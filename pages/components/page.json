{
  "title": {
    "text": "组件",
    "fontSize": 18,
    "color": "#FFFFFF",
    "background": "#006A65"
  },
  "style": {
    "padding": 10,
    "background": "#F5F5F5"
  },
  "body": [
    { "type": "space", "height": 8 },
    { "type": "text", "text": "基础", "style": { "fontWeight": "bold" } },
    { "type": "notice", "text": "文案、图片、头像、按钮、省略" },
    {
      "type": "list",
      "bind": "basic",
      "item": {
        "type": "card",
        "action": { "type": "navigate", "page": "{{item.page}}" },
        "children": [
          {
            "type": "row",
            "style": { "gap": 8 },
            "children": [
              { "type": "text", "text": "{{item.name}}", "style": { "weight": 1, "fontWeight": "bold" } },
              { "type": "notice", "text": "{{item.desc}}" }
            ]
          }
        ]
      }
    },
    { "type": "space", "height": 8 },
    { "type": "text", "text": "表单", "style": { "fontWeight": "bold" } },
    { "type": "notice", "text": "输入、选择、步进器、评分、进度" },
    {
      "type": "list",
      "bind": "forms",
      "item": {
        "type": "card",
        "action": { "type": "navigate", "page": "{{item.page}}" },
        "children": [
          {
            "type": "row",
            "style": { "gap": 8 },
            "children": [
              { "type": "text", "text": "{{item.name}}", "style": { "weight": 1, "fontWeight": "bold" } },
              { "type": "notice", "text": "{{item.desc}}" }
            ]
          }
        ]
      }
    },
    { "type": "space", "height": 8 },
    { "type": "text", "text": "导航", "style": { "fontWeight": "bold" } },
    { "type": "notice", "text": "选项卡、分段、导航栏、侧边栏、序列、步骤" },
    {
      "type": "list",
      "bind": "nav",
      "item": {
        "type": "card",
        "action": { "type": "navigate", "page": "{{item.page}}" },
        "children": [
          {
            "type": "row",
            "style": { "gap": 8 },
            "children": [
              { "type": "text", "text": "{{item.name}}", "style": { "weight": 1, "fontWeight": "bold" } },
              { "type": "notice", "text": "{{item.desc}}" }
            ]
          }
        ]
      }
    },
    { "type": "space", "height": 8 },
    { "type": "text", "text": "展示", "style": { "fontWeight": "bold" } },
    { "type": "notice", "text": "走马灯、查看器、通告栏、空状态、加载、骨架屏" },
    {
      "type": "list",
      "bind": "display",
      "item": {
        "type": "card",
        "action": { "type": "navigate", "page": "{{item.page}}" },
        "children": [
          {
            "type": "row",
            "style": { "gap": 8 },
            "children": [
              { "type": "text", "text": "{{item.name}}", "style": { "weight": 1, "fontWeight": "bold" } },
              { "type": "notice", "text": "{{item.desc}}" }
            ]
          }
        ]
      }
    },
    { "type": "space", "height": 8 },
    { "type": "text", "text": "反馈", "style": { "fontWeight": "bold" } },
    { "type": "notice", "text": "弹层、动作面板" },
    {
      "type": "list",
      "bind": "feedback",
      "item": {
        "type": "card",
        "action": { "type": "navigate", "page": "{{item.page}}" },
        "children": [
          {
            "type": "row",
            "style": { "gap": 8 },
            "children": [
              { "type": "text", "text": "{{item.name}}", "style": { "weight": 1, "fontWeight": "bold" } },
              { "type": "notice", "text": "{{item.desc}}" }
            ]
          }
        ]
      }
    },
    { "type": "space", "height": 8 },
    { "type": "text", "text": "布局", "style": { "fontWeight": "bold" } },
    { "type": "notice", "text": "行列、列表、宫格、自定义组件" },
    {
      "type": "list",
      "bind": "layout",
      "item": {
        "type": "card",
        "action": { "type": "navigate", "page": "{{item.page}}" },
        "children": [
          {
            "type": "row",
            "style": { "gap": 8 },
            "children": [
              { "type": "text", "text": "{{item.name}}", "style": { "weight": 1, "fontWeight": "bold" } },
              { "type": "notice", "text": "{{item.desc}}" }
            ]
          }
        ]
      }
    },
    { "type": "space", "height": 8 },
    { "type": "text", "text": "页面", "style": { "fontWeight": "bold" } },
    { "type": "notice", "text": "整页布局和顶栏示例" },
    {
      "type": "list",
      "bind": "pages",
      "item": {
        "type": "card",
        "action": { "type": "navigate", "page": "{{item.page}}" },
        "children": [
          {
            "type": "row",
            "style": { "gap": 8 },
            "children": [
              { "type": "text", "text": "{{item.name}}", "style": { "weight": 1, "fontWeight": "bold" } },
              { "type": "notice", "text": "{{item.desc}}" }
            ]
          }
        ]
      }
    }
  ]
}
