{
  "title": {
    "text": "下拉",
    "fontSize": 18,
    "color": "#FFFFFF",
    "background": "#006A65"
  },
  "style": {
    "background": "#F5F5F5",
    "padding": 12
  },
  "body": [
    { "type": "notice", "text": "pages/select/page.js" },
    { "type": "notice", "text": "点击弹出选项。options 可写 { label, value }，也可写字符串数组。" },
    { "type": "space", "height": 8 },
    {
      "type": "card",
      "children": [
        {
          "type": "select",
          "name": "platform",
          "label": "平台",
          "options": [
            { "label": "抖音", "value": "dy" },
            { "label": "小红书", "value": "xhs" },
            { "label": "快手", "value": "ks" }
          ]
        },
        {
          "type": "select",
          "name": "level",
          "label": "优先级",
          "options": ["高", "中", "低"]
        },
        { "type": "notice", "text": "平台 {{platform}} · 优先级 {{level}}" }
      ]
    }
  ]
}
