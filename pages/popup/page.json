{
  "title": {
    "text": "弹层",
    "fontSize": 18,
    "color": "#FFFFFF",
    "background": "#006A65"
  },
  "style": {
    "background": "#F5F5F5",
    "padding": 12
  },
  "body": [
    { "type": "notice", "text": "打开关闭都走 setData + showIf。点遮罩会把对应字段写成 false。" },
    { "type": "space", "height": 8 },
    { "type": "button", "text": "底部表单", "onClick": "onOpenForm" },
    { "type": "button", "text": "顶部提示", "onClick": "onOpenTop" },
    { "type": "button", "text": "居中确认", "onClick": "onOpenConfirm" },
    { "type": "button", "text": "左侧筛选", "onClick": "onOpenLeft" },
    { "type": "notice", "text": "备注 {{remark}}" },
    { "type": "notice", "text": "平台 {{platform}}" }
  ],
  "popups": [
    {
      "title": "编辑备注",
      "position": "bottom",
      "showIf": "formOpen",
      "style": { "radius": 16 },
      "body": [
        { "type": "textarea", "name": "remark", "label": "备注", "hint": "请输入", "minLines": 3 },
        { "type": "button", "text": "保存", "onClick": "onSaveForm" }
      ]
    },
    {
      "title": "提示",
      "position": "top",
      "showIf": "topOpen",
      "style": { "radius": 20 },
      "body": [
        { "type": "notice", "text": "从顶部滑下来的内容。" },
        { "type": "button", "text": "知道了", "onClick": "onCloseTop" }
      ]
    },
    {
      "position": "center",
      "showIf": "confirmOpen",
      "width": "80%",
      "style": { "radius": 12, "borderWidth": 1, "borderColor": "#006A65" },
      "body": [
        { "type": "title", "text": "确认删除？", "style": { "align": "center" } },
        { "type": "notice", "text": "删除后无法恢复", "style": { "align": "center" } },
        {
          "type": "row",
          "style": { "gap": 8 },
          "children": [
            { "type": "button", "text": "取消", "onClick": "onCloseConfirm" },
            { "type": "button", "text": "删除", "onClick": "onCloseConfirm" }
          ]
        }
      ]
    },
    {
      "title": "筛选",
      "position": "left",
      "showIf": "leftOpen",
      "style": { "radius": 8 },
      "body": [
        {
          "type": "select",
          "name": "platform",
          "label": "平台",
          "options": [
            { "label": "抖音", "value": "dy" },
            { "label": "小红书", "value": "xhs" },
            { "label": "快手", "value": "ks" }
          ]
        },
        { "type": "button", "text": "确定", "onClick": "onCloseLeft" }
      ]
    }
  ]
}
