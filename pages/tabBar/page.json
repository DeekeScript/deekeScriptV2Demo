{
  "title": {
    "text": "底部菜单",
    "fontSize": 18,
    "color": "#FFFFFF",
    "background": "#006A65"
  },
  "style": {
    "padding": 12,
    "background": "#F5F5F5"
  },
  "body": [
    { "type": "notice", "text": "文字色 color / selectedColor，图标色 iconColor / selectedIconColor，只传要改的字段。点首页 / 能力会提示。返回后恢复默认。" },
    { "type": "space", "height": 8 },
    {
      "type": "row",
      "style": { "gap": 8 },
      "children": [
        { "type": "button", "text": "角标 9", "onTap": "onBadge", "style": { "weight": 1 } },
        { "type": "button", "text": "清角标", "onTap": "onClearBadge", "style": { "weight": 1 } }
      ]
    },
    {
      "type": "row",
      "style": { "gap": 8 },
      "children": [
        { "type": "button", "text": "隐藏组件", "onTap": "onHideComponents", "style": { "weight": 1 } },
        { "type": "button", "text": "显示组件", "onTap": "onShowComponents", "style": { "weight": 1 } }
      ]
    },
    {
      "type": "row",
      "style": { "gap": 8 },
      "children": [
        { "type": "button", "text": "改成控件", "onTap": "onRename", "style": { "weight": 1 } },
        { "type": "button", "text": "恢复文字", "onTap": "onRestoreName", "style": { "weight": 1 } }
      ]
    },
    {
      "type": "row",
      "style": { "gap": 8 },
      "children": [
        { "type": "button", "text": "橙色文字", "onTap": "onOrangeText", "style": { "weight": 1 } },
        { "type": "button", "text": "橙色图标", "onTap": "onOrangeIcon", "style": { "weight": 1 } }
      ]
    },
    {
      "type": "row",
      "style": { "gap": 8 },
      "children": [
        { "type": "button", "text": "深色背景", "onTap": "onDarkBar", "style": { "weight": 1 } },
        { "type": "button", "text": "浅色背景", "onTap": "onLightBar", "style": { "weight": 1 } }
      ]
    }
  ]
}
