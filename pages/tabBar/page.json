{
  "title": {
    "text": "底部菜单",
    "fontSize": 18,
    "color": "#FFFFFF",
    "background": "#006A65"
  },
  "style": {
    "padding": 12,
    "background": "#F5F5F5"
  },
  "body": [
    { "type": "notice", "text": "文字用 setTabBarItem 的 title。图标色和文字色是整栏的，用 setTabBarStyle 的 color / selectedColor。点首页 / 能力会提示。返回后恢复默认。" },
    { "type": "space", "height": 8 },
    {
      "type": "row",
      "style": { "gap": 8 },
      "children": [
        { "type": "button", "text": "角标 9", "onTap": "onBadge", "style": { "weight": 1 } },
        { "type": "button", "text": "清角标", "onTap": "onClearBadge", "style": { "weight": 1 } }
      ]
    },
    {
      "type": "row",
      "style": { "gap": 8 },
      "children": [
        { "type": "button", "text": "隐藏组件", "onTap": "onHideComponents", "style": { "weight": 1 } },
        { "type": "button", "text": "显示组件", "onTap": "onShowComponents", "style": { "weight": 1 } }
      ]
    },
    {
      "type": "row",
      "style": { "gap": 8 },
      "children": [
        { "type": "button", "text": "改成控件", "onTap": "onRename", "style": { "weight": 1 } },
        { "type": "button", "text": "恢复文字", "onTap": "onRestoreName", "style": { "weight": 1 } }
      ]
    },
    {
      "type": "row",
      "style": { "gap": 6 },
      "children": [
        { "type": "button", "text": "橙色配色", "onTap": "onOrangeBar", "size": "sm", "style": { "weight": 1 } },
        { "type": "button", "text": "深色底栏", "onTap": "onDarkBar", "size": "sm", "style": { "weight": 1 } },
        { "type": "button", "text": "浅色底栏", "onTap": "onLightBar", "size": "sm", "style": { "weight": 1 } }
      ]
    }
  ]
}
