{
  "title": {
    "text": "底部菜单",
    "fontSize": 18,
    "color": "#FFFFFF",
    "background": "#006A65"
  },
  "style": {
    "padding": 12,
    "background": "#F5F5F5"
  },
  "body": [
    { "type": "notice", "text": "进入本页会创建底栏。点首页 / 能力会提示，不会跳转。点按钮改角标、隐藏、颜色。返回后恢复默认。" },
    { "type": "space", "height": 8 },
    {
      "type": "row",
      "style": { "gap": 8 },
      "children": [
        { "type": "button", "text": "角标 9", "onTap": "onBadge", "style": { "weight": 1 } },
        { "type": "button", "text": "清角标", "onTap": "onClearBadge", "style": { "weight": 1 } }
      ]
    },
    {
      "type": "row",
      "style": { "gap": 8 },
      "children": [
        { "type": "button", "text": "隐藏组件", "onTap": "onHideComponents", "style": { "weight": 1 } },
        { "type": "button", "text": "显示组件", "onTap": "onShowComponents", "style": { "weight": 1 } }
      ]
    },
    {
      "type": "row",
      "style": { "gap": 8 },
      "children": [
        { "type": "button", "text": "深色底栏", "onTap": "onDarkBar", "style": { "weight": 1 } },
        { "type": "button", "text": "浅色底栏", "onTap": "onLightBar", "style": { "weight": 1 } }
      ]
    }
  ]
}
