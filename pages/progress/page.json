{
  "title": {
    "text": "进度条",
    "fontSize": 18,
    "color": "#FFFFFF",
    "background": "#006A65"
  },
  "style": {
    "background": "#F5F5F5",
    "padding": 12
  },
  "body": [
    { "type": "notice", "text": "pages/progress/page.js" },
    { "type": "notice", "text": "progressBar 只展示进度，不能拖动。可拖动的刻度见滑动输入条。" },
    { "type": "space", "height": 8 },
    {
      "type": "card",
      "children": [
        {
          "type": "progressBar",
          "name": "speed",
          "label": "运行速度",
          "value": 50,
          "min": 0,
          "max": 100,
          "unit": "%"
        },
        {
          "type": "progressBar",
          "name": "upload",
          "label": "上传进度",
          "value": 70,
          "unit": "%"
        },
        {
          "type": "progressBar",
          "name": "cpu",
          "label": "占用",
          "value": 36,
          "unit": "%",
          "strokeWidth": 3,
          "style": { "color": "#C2410C" }
        },
        {
          "type": "progressBar",
          "name": "done",
          "label": "已完成",
          "value": 100,
          "unit": "%"
        }
      ]
    },
    { "type": "space", "height": 8 },
    { "type": "notice", "text": "速度 {{speed}}% · 上传 {{upload}}% · 占用 {{cpu}}%" }
  ]
}
