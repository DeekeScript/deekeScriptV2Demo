{
  "title": {
    "text": "综合表单",
    "fontSize": 18,
    "color": "#FFFFFF",
    "background": "#006A65"
  },
  "style": {
    "background": "#F5F5F5",
    "padding": 12
  },
  "body": [
    { "type": "notice", "text": "pages/form/page.js" },
    { "type": "notice", "text": "多个字段拼一页。各组件独立示例见组件列表。输入会写回 this.data，点保存才持久化。" },
    { "type": "space", "height": 8 },
    {
      "type": "card",
      "children": [
        { "type": "text", "text": "边框输入", "style": { "fontWeight": "bold" } },
        { "type": "input", "name": "task_name", "label": "任务名", "hint": "例如：每日关注", "variant": "box", "value": "每日关注" },
        { "type": "input", "name": "nickname", "label": "账号备注", "hint": "选填", "variant": "box" },
        { "type": "input", "name": "count", "label": "次数", "hint": "整数", "inputType": "digit", "variant": "box", "value": "20" },
        { "type": "textarea", "name": "remark", "label": "备注", "hint": "补充说明", "minLines": 3, "variant": "box" }
      ]
    },
    { "type": "space", "height": 8 },
    {
      "type": "card",
      "children": [
        { "type": "text", "text": "动态关键词", "style": { "fontWeight": "bold" } },
        { "type": "notice", "text": "点「增加一项」会 appendData，输入框数量跟着变。" },
        {
          "type": "list",
          "bind": "extras",
          "item": {
            "type": "input",
            "name": "{{item.key}}",
            "label": "{{item.label}}",
            "hint": "选填",
            "variant": "box"
          }
        },
        {
          "type": "row",
          "style": { "gap": 8 },
          "children": [
            { "type": "button", "text": "增加一项", "size": "md", "onTap": "onAddExtra" },
            { "type": "button", "text": "去掉最后一项", "size": "md", "style": { "background": "#5F6D6B" }, "onTap": "onRemoveExtra" }
          ]
        }
      ]
    },
    { "type": "space", "height": 8 },
    {
      "type": "row",
      "style": { "gap": 8 },
      "children": [
        { "type": "button", "text": "保存", "onTap": "onSave", "action": { "type": "save", "toast": "已写入本地" } },
        { "type": "button", "text": "提示", "size": "md", "action": { "type": "toast", "text": "任务名：{{task_name}}" } }
      ]
    }
  ]
}
