{
  "title": {
    "text": "选择器",
    "fontSize": 18,
    "color": "#FFFFFF",
    "background": "#006A65"
  },
  "style": {
    "background": "#F5F5F5",
    "padding": 12
  },
  "body": [
    { "type": "notice", "text": "pages/picker/page.js" },
    { "type": "notice", "text": "周几和上下午两列一起选。日期和时间见日期时间选择器。" },
    { "type": "space", "height": 8 },
    {
      "type": "card",
      "children": [
        {
          "type": "picker",
          "name": "slot",
          "label": "星期时段",
          "value": "周一/上午",
          "options": [
            { "text": "周一", "children": ["上午", "下午"] },
            { "text": "周二", "children": ["上午", "下午"] },
            { "text": "周三", "children": ["上午", "下午"] },
            { "text": "周四", "children": ["上午", "下午"] },
            { "text": "周五", "children": ["上午", "下午"] },
            { "text": "周六", "children": ["上午", "下午"] },
            { "text": "周日", "children": ["上午", "下午"] }
          ]
        }
      ]
    },
    { "type": "space", "height": 8 },
    { "type": "notice", "text": "{{slot}}" },
    { "type": "space", "height": 8 },
    { "type": "notice", "text": "底部滚轮选一项；适合只要上午/下午这种两项。" },
    { "type": "space", "height": 8 },
    {
      "type": "card",
      "children": [
        { "type": "picker", "name": "ampm", "label": "时段", "value": "上午", "options": ["上午", "下午"] }
      ]
    },
    { "type": "space", "height": 8 },
    { "type": "notice", "text": "{{ampm}}" }
  ]
}
