{
  "title": {
    "text": "分段",
    "fontSize": 18,
    "color": "#FFFFFF",
    "background": "#006A65"
  },
  "style": { "background": "#F5F5F5", "padding": 12 },
  "body": [
    { "type": "notice", "text": "pages/segmented/page.js" },
    { "type": "notice", "text": "同一行里切换几个互斥选项，比 tabs 更紧凑。" },
    { "type": "space", "height": 8 },
    {
      "type": "card",
      "children": [
        {
          "type": "segmented",
          "name": "range",
          "value": "day",
          "onChange": "onRange",
          "options": [
            { "label": "日", "value": "day" },
            { "label": "周", "value": "week" },
            { "label": "月", "value": "month" }
          ]
        },
        { "type": "space", "height": 12 },
        { "type": "text", "text": "{{hint}}" }
      ]
    }
  ]
}
