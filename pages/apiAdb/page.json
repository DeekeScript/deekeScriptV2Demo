{
  "title": { "text": "Adb 无线调试", "fontSize": 18, "color": "#FFFFFF", "background": "#006A65" },
  "style": { "background": "#F5F5F5", "padding": 12 },
  "body": [
    {
      "type": "notice",
      "text": "Android 11+。首次配对（分屏手输 / 无障碍读码）请先看「Adb 连接方法」。本页负责日常重连、手填参数和 shell 验证。"
    },
    { "type": "space", "height": 8 },
    {
      "type": "button",
      "size": "sm",
      "text": "如何首次连接（分屏 / 无障碍读码）",
      "onTap": "onGoConnect",
      "style": { "background": "#0B6E4F", "color": "#FFFFFF" }
    },
    { "type": "space", "height": 8 },
    {
      "type": "card",
      "children": [
        { "type": "text", "text": "状态", "style": { "fontWeight": "bold" } },
        { "type": "notice", "text": "{{status}}" },
        { "type": "text", "text": "最近结果", "style": { "fontWeight": "bold" } },
        { "type": "notice", "text": "{{result}}" }
      ]
    },
    { "type": "space", "height": 8 },
    {
      "type": "row",
      "style": { "gap": 6 },
      "children": [
        { "type": "button", "size": "sm", "text": "刷新状态", "onTap": "onRefresh", "style": { "weight": 1 } },
        { "type": "button", "size": "sm", "text": "打开无线调试", "onTap": "onOpenWireless", "style": { "weight": 1 } }
      ]
    },
    { "type": "space", "height": 8 },
    {
      "type": "text",
      "text": "备选：手填全部参数",
      "style": { "fontWeight": "bold", "color": "#006A65" }
    },
    { "type": "space", "height": 4 },
    {
      "type": "button",
      "size": "sm",
      "text": "手动填全部参数",
      "onTap": "onPairManual"
    },
    { "type": "space", "height": 8 },
    {
      "type": "text",
      "text": "日常连接",
      "style": { "fontWeight": "bold", "color": "#006A65" }
    },
    { "type": "space", "height": 4 },
    {
      "type": "row",
      "style": { "gap": 6 },
      "children": [
        { "type": "button", "size": "sm", "text": "历史端口重连", "onTap": "onConnectSaved", "style": { "weight": 1 } },
        { "type": "button", "size": "sm", "text": "手填连接端口", "onTap": "onConnectPort", "style": { "weight": 1 } },
        { "type": "button", "size": "sm", "text": "断开", "onTap": "onDisconnect", "style": { "weight": 1 } }
      ]
    },
    { "type": "space", "height": 8 },
    {
      "type": "text",
      "text": "验证",
      "style": { "fontWeight": "bold", "color": "#006A65" }
    },
    { "type": "space", "height": 4 },
    {
      "type": "row",
      "style": { "gap": 6 },
      "children": [
        { "type": "button", "size": "sm", "text": "shell id", "onTap": "onShellId", "style": { "weight": 1 } },
        { "type": "button", "size": "sm", "text": "Home", "onTap": "onHome", "style": { "weight": 1 } },
        { "type": "button", "size": "sm", "text": "方法列表", "onTap": "onHelp", "style": { "weight": 1 } }
      ]
    },
    { "type": "space", "height": 8 },
    {
      "type": "button",
      "size": "sm",
      "text": "说明",
      "onTap": "onHint"
    }
  ]
}
