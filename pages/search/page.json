{
  "title": {
    "text": "搜索",
    "fontSize": 18,
    "color": "#FFFFFF",
    "background": "#006A65"
  },
  "style": {
    "background": "#F5F5F5",
    "padding": 12
  },
  "body": [
    { "type": "notice", "text": "pages/search/page.js" },
    { "type": "notice", "text": "圆角搜索框。键盘搜索键会触发 onChange。" },
    { "type": "space", "height": 8 },
    {
      "type": "card",
      "children": [
        { "type": "search", "name": "keyword", "hint": "搜索任务", "onChange": "onKeyword" },
        { "type": "notice", "text": "当前：{{keyword}}" }
      ]
    }
  ]
}
