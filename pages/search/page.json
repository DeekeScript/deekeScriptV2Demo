{
  "title": {
    "text": "搜索框",
    "fontSize": 18,
    "color": "#FFFFFF",
    "background": "#006A65"
  },
  "style": {
    "background": "#F5F5F5",
    "padding": 12
  },
  "body": [
    { "type": "notice", "text": "pages/search/page.js" },
    { "type": "notice", "text": "type 写 searchBar 或 search。可换图标、方形、取消按钮；键盘搜索走 onSearch。" },
    { "type": "space", "height": 8 },
    {
      "type": "card",
      "children": [
        { "type": "searchBar", "name": "keyword", "hint": "搜索任务", "onChange": "onKeyword", "onSearch": "onSearch" },
        { "type": "notice", "text": "当前：{{keyword}}" },
        { "type": "space", "height": 8 },
        { "type": "searchBar", "name": "noIcon", "hint": "不显示图标", "icon": false },
        { "type": "space", "height": 8 },
        { "type": "searchBar", "name": "squareQ", "hint": "方形搜索", "shape": "square" },
        { "type": "space", "height": 8 },
        { "type": "searchBar", "name": "cancelQ", "hint": "带取消", "showCancel": true, "cancelText": "取消", "onCancel": "onCancelSearch" },
        { "type": "space", "height": 8 },
        { "type": "searchBar", "name": "blueQ", "hint": "蓝色取消", "showCancel": true, "style": { "color": "#1565C0" }, "onCancel": "onCancelBlue" }
      ]
    }
  ]
}
