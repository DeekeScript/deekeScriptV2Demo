{
  "title": {
    "text": "搜索",
    "fontSize": 18,
    "color": "#FFFFFF",
    "background": "#006A65"
  },
  "style": {
    "background": "#F5F5F5",
    "padding": 12
  },
  "body": [
    { "type": "notice", "text": "pages/search/page.js" },
    { "type": "notice", "text": "默认左侧有放大镜。写 icon 可换成项目内图片；icon: false 则隐藏。" },
    { "type": "space", "height": 8 },
    {
      "type": "card",
      "children": [
        { "type": "search", "name": "keyword", "hint": "搜索任务", "onChange": "onKeyword" },
        { "type": "notice", "text": "当前：{{keyword}}" },
        { "type": "space", "height": 8 },
        { "type": "search", "name": "noIcon", "hint": "不显示图标", "icon": false }
      ]
    }
  ]
}
