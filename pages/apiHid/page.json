{
  "title": { "text": "Hid", "fontSize": 18, "color": "#FFFFFF", "background": "#006A65" },
  "style": { "background": "#F5F5F5", "padding": 12 },
  "body": [
    { "type": "notice", "text": "需蓝牙 HID 硬件。先连接，再刷新状态。本页不演示点击/找图，避免没设备时报错刷屏。" },
    { "type": "space", "height": 8 },
    {
      "type": "card",
      "children": [
        { "type": "text", "text": "isConnected", "style": { "fontWeight": "bold" } },
        { "type": "notice", "text": "{{connected}}" },
        { "type": "text", "text": "设备", "style": { "fontWeight": "bold" } },
        { "type": "notice", "text": "{{name}}" },
        { "type": "text", "text": "状态", "style": { "fontWeight": "bold" } },
        { "type": "notice", "text": "{{status}}" }
      ]
    },
    { "type": "space", "height": 8 },
    {
      "type": "row",
      "style": { "gap": 6 },
      "children": [
        {
          "type": "button",
          "size": "sm",
          "text": "连接",
          "onTap": "onConnect",
          "style": { "weight": 1, "background": "#006A65", "color": "#FFFFFF" }
        },
        { "type": "button", "size": "sm", "text": "断开", "onTap": "onDisconnect", "style": { "weight": 1 } }
      ]
    },
    { "type": "space", "height": 6 },
    {
      "type": "row",
      "style": { "gap": 6 },
      "children": [
        { "type": "button", "size": "sm", "text": "刷新状态", "onTap": "onRefresh", "style": { "weight": 1 } },
        { "type": "button", "size": "sm", "text": "说明", "onTap": "onHint", "style": { "weight": 1 } }
      ]
    }
  ]
}
