{
  "title": {
    "text": "居中布局",
    "align": "center",
    "fontSize": 18,
    "color": "#FFFFFF",
    "background": "#006A65"
  },
  "style": {
    "background": "#F5F5F5",
    "padding": 24
  },
  "body": [
    {
      "type": "column",
      "style": {
        "height": "100%",
        "align": "center",
        "valign": "center",
        "gap": 12
      },
      "children": [
        { "type": "image", "src": "img/home.svg", "style": { "width": 64, "height": 64 } },
        { "type": "title", "text": "空状态", "style": { "align": "center" } },
        { "type": "notice", "text": "column 设 height 100% 再 valign center，可以把内容摆在屏幕中间。", "style": { "align": "center" } },
        { "type": "button", "text": "返回首页", "action": { "type": "back" } }
      ]
    }
  ]
}
