{
  "title": { "text": "Device Owner", "fontSize": 18, "color": "#FFFFFF", "background": "#006A65" },
  "style": { "background": "#F5F5F5", "padding": 12 },
  "body": [
    { "type": "notice", "text": "覆盖 DevicePolicy 探测。Kiosk / DeviceApp / DeviceHardware 需 DO 权限，展厅不演示破坏性操作。" },
    { "type": "space", "height": 8 },
    {
      "type": "card",
      "children": [
        { "type": "text", "text": "isDeviceOwner", "style": { "fontWeight": "bold" } },
        { "type": "notice", "text": "{{owner}}" },
        { "type": "text", "text": "状态", "style": { "fontWeight": "bold" } },
        { "type": "notice", "text": "{{status}}" }
      ]
    },
    { "type": "space", "height": 8 },
    {
      "type": "row",
      "style": { "gap": 6 },
      "children": [
        { "type": "button", "size": "sm", "text": "刷新探测", "onTap": "onRefresh", "style": { "weight": 1 } },
        { "type": "button", "size": "sm", "text": "说明", "onTap": "onHint", "style": { "weight": 1 } }
      ]
    }
  ]
}
