{
  "title": {
    "text": "详情",
    "fontSize": 18,
    "color": "#FFFFFF",
    "background": "#006A65"
  },
  "style": {
    "padding": 10,
    "background": "#F5F5F5"
  },
  "body": [
    { "type": "title", "text": "{{item.title}}" },
    { "type": "notice", "text": "编号 {{params.id}}" },
    { "type": "divider" },
    {
      "type": "card",
      "children": [
        {
          "type": "row",
          "style": { "gap": 10 },
          "children": [
            { "type": "image", "src": "{{item.icon}}", "style": { "width": 40, "height": 40, "radius": 8 } },
            {
              "type": "column",
              "style": { "weight": 1, "gap": 4 },
              "children": [
                { "type": "text", "text": "状态：{{item.status}}", "showIf": "item.status" },
                { "type": "text", "text": "运营：{{item.user}}", "showIf": "item.user" }
              ]
            }
          ]
        },
        { "type": "notice", "text": "{{item.time}}" }
      ]
    },
    { "type": "space", "height": 8 },
    {
      "type": "row",
      "style": { "gap": 8 },
      "children": [
        { "type": "button", "text": "运行", "showIf": "item.jsFile", "onClick": "onRun" },
        { "type": "button", "text": "提示", "action": { "type": "toast", "text": "已加入队列" } },
        { "type": "button", "text": "返回", "action": { "type": "back" } }
      ]
    }
  ]
}
