{
  "title": {
    "text": "详情",
    "fontSize": 18,
    "color": "#FFFFFF",
    "background": "#006A65"
  },
  "style": {
    "padding": 10,
    "background": "#F5F5F5"
  },
  "body": [
    {
      "type": "card",
      "children": [
        {
          "type": "row",
          "style": { "gap": 12 },
          "children": [
            { "type": "image", "src": "{{item.icon}}", "showIf": "item.icon", "style": { "width": 44, "height": 44, "radius": 10 } },
            {
              "type": "column",
              "style": { "weight": 1, "gap": 4 },
              "children": [
                { "type": "text", "text": "{{item.title}}", "style": { "fontWeight": "bold", "fontSize": 16 } },
                { "type": "notice", "text": "{{item.sub}}", "showIf": "item.sub" }
              ]
            },
            {
              "type": "tag",
              "text": "{{item.status}}",
              "showIf": "item.status",
              "style": { "background": "#E6F4F1", "color": "#006A65" }
            }
          ]
        }
      ]
    },
    { "type": "space", "height": 8 },
    {
      "type": "card",
      "showIf": "item.jsFile",
      "children": [
        { "type": "text", "text": "脚本", "style": { "fontWeight": "bold" } },
        { "type": "notice", "text": "{{item.jsFile}}" }
      ]
    },
    { "type": "space", "height": 8 },
    {
      "type": "row",
      "style": { "gap": 8 },
      "children": [
        { "type": "button", "text": "运行", "showIf": "item.jsFile", "onClick": "onRun", "style": { "weight": 1 } },
        {
          "type": "button",
          "text": "返回",
          "action": { "type": "back" },
          "style": { "weight": 1, "background": "#EEF2F1", "color": "#006A65" }
        }
      ]
    }
  ]
}
