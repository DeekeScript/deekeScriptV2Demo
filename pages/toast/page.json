{
  "title": { "text": "轻提示", "fontSize": 18, "color": "#FFFFFF", "background": "#006A65" },
  "style": { "background": "#F5F5F5", "padding": 12 },
  "body": [
    { "type": "notice", "text": "pages/toast/page.js" },
    { "type": "notice", "text": "this.toast() 约 1.6 秒后消失；组件 toast 用 showIf 自己控制。" },
    { "type": "space", "height": 8 },
    { "type": "button", "text": "this.toast()", "onTap": "onApi" },
    { "type": "button", "text": "组件 Toast", "onTap": "onNode" },
    { "type": "button", "text": "蓝色 Toast", "onTap": "onBlue" },
    {
      "type": "toast",
      "showIf": "show",
      "text": "已复制到剪贴板",
      "position": "center"
    },
    {
      "type": "toast",
      "showIf": "blue",
      "text": "style.background / color",
      "position": "center",
      "style": { "background": "#1565C0", "color": "#FFFFFF" }
    }
  ]
}
