{
  "title": {
    "text": "列表",
    "fontSize": 18,
    "color": "#FFFFFF",
    "background": "#006A65"
  },
  "style": {
    "background": "#F5F5F5",
    "padding": 12
  },
  "body": [
    {
      "type": "search",
      "name": "keyword",
      "hint": "搜索任务",
      "onChange": "onSearch",
      "style": { "sticky": "top", "background": "#F5F5F5", "paddingBottom": 8 }
    },
    { "type": "notice", "text": "点卡片进详情，点运行执行 tasks/sample.js。滑到底会加载，没有数据后显示底线。" },
    { "type": "space", "height": 8 },
    {
      "type": "list",
      "bind": "tasks",
      "empty": "暂无任务",
      "item": {
        "type": "card",
        "action": {
          "type": "navigate",
          "page": "pages/detail",
          "params": { "id": "{{item.id}}" }
        },
        "children": [
          {
            "type": "row",
            "style": { "gap": 8 },
            "children": [
              { "type": "image", "src": "{{item.icon}}", "style": { "width": 36, "height": 36, "radius": 18 } },
              {
                "type": "column",
                "style": { "weight": 1, "gap": 2 },
                "children": [
                  {
                    "type": "row",
                    "style": { "gap": 6 },
                    "children": [
                      { "type": "text", "text": "{{item.title}}", "style": { "weight": 1, "fontWeight": "bold" } },
                      { "type": "tag", "text": "{{item.status}}" }
                    ]
                  },
                  { "type": "notice", "text": "{{item.time}}" }
                ]
              },
              {
                "type": "button",
                "text": "运行",
                "size": "sm",
                "onClick": "onRun"
              }
            ]
          }
        ]
      }
    },
    { "type": "loading", "text": "加载中", "showIf": "loading" },
    {
      "type": "text",
      "text": "{{footer}}",
      "showIf": "noMore",
      "style": { "align": "center", "color": "#9AA8A6", "fontSize": 12 }
    }
  ]
}
