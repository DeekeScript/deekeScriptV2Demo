{
  "title": { "text": "分页符", "fontSize": 18, "color": "#FFFFFF", "background": "#006A65" },
  "style": { "background": "#F5F5F5", "padding": 12 },
  "body": [
    { "type": "notice", "text": "pages/pageIndicator/page.js" },
    { "type": "notice", "text": "点圆点切换当前页。variant: line 为短条。direction: column 为竖排。" },
    { "type": "space", "height": 8 },
    {
      "type": "card",
      "children": [
        { "type": "text", "text": "横排", "style": { "fontWeight": "bold" } },
        { "type": "pageIndicator", "name": "page", "count": 5, "value": 1 },
        { "type": "space", "height": 8 },
        { "type": "pageIndicator", "name": "line", "count": 4, "value": 0, "variant": "line" },
        { "type": "notice", "text": "当前第 {{page}} 页" }
      ]
    },
    { "type": "space", "height": 8 },
    {
      "type": "card",
      "children": [
        { "type": "text", "text": "竖排", "style": { "fontWeight": "bold" } },
        {
          "type": "row",
          "style": { "gap": 24 },
          "children": [
            {
              "type": "column",
              "style": { "weight": 1, "align": "center", "gap": 8 },
              "children": [
                { "type": "notice", "text": "圆点" },
                { "type": "pageIndicator", "name": "vpage", "count": 5, "value": 2, "direction": "column" }
              ]
            },
            {
              "type": "column",
              "style": { "weight": 1, "align": "center", "gap": 8 },
              "children": [
                { "type": "notice", "text": "短条" },
                { "type": "pageIndicator", "name": "vline", "count": 4, "value": 1, "variant": "line", "direction": "column" }
              ]
            }
          ]
        },
        { "type": "notice", "text": "当前第 {{vpage}} 页" }
      ]
    }
  ]
}
