{
  "title": {
    "text": "加载",
    "fontSize": 18,
    "color": "#FFFFFF",
    "background": "#006A65"
  },
  "style": {
    "background": "#F5F5F5",
    "padding": 12
  },
  "body": [
    { "type": "notice", "text": "pages/loading/page.js" },
    { "type": "notice", "text": "几种常见加载效果。整页遮罩用 this.showLoading / this.hideLoading。列表滑到底再出转圈，见列表示例。" },
    { "type": "notice", "text": "横向 · 转圈 + 文字" },
    { "type": "card", "children": [{ "type": "loading", "text": "加载中" }] },
    { "type": "notice", "text": "仅转圈" },
    { "type": "card", "children": [{ "type": "loading" }] },
    { "type": "notice", "text": "纵向 · 大转圈" },
    { "type": "card", "children": [{ "type": "loading", "text": "正在同步…", "mode": "column", "size": 28 }] },
    { "type": "notice", "text": "三点跳动" },
    { "type": "card", "children": [{ "type": "loading", "text": "请稍候", "mode": "dots" }] },
    { "type": "notice", "text": "自定义颜色" },
    { "type": "card", "children": [{ "type": "loading", "text": "蓝色加载", "style": { "color": "#1565C0" } }] },
    { "type": "card", "children": [{ "type": "loading", "text": "橙色三点", "mode": "dots", "style": { "color": "#C45C26" } }] },
    { "type": "button", "text": "整页遮罩 1.6 秒", "onTap": "onMask" }
  ]
}
