{
  "title": {
    "text": "区间",
    "fontSize": 18,
    "color": "#FFFFFF",
    "background": "#006A65"
  },
  "style": {
    "background": "#F5F5F5",
    "padding": 12
  },
  "body": [
    { "type": "notice", "text": "pages/range/page.js" },
    { "type": "notice", "text": "一行两个输入。失焦后后面的数不会小于前面的。" },
    { "type": "space", "height": 8 },
    {
      "type": "card",
      "children": [
        {
          "type": "range",
          "label": "关注数量",
          "separator": "~",
          "inputType": "number",
          "start": { "name": "follow_min", "hint": "最小", "value": "10" },
          "end": { "name": "follow_max", "hint": "最大", "value": "80" }
        },
        {
          "type": "range",
          "label": "边框区间",
          "separator": "~",
          "variant": "box",
          "inputType": "digit",
          "start": { "name": "age_min", "hint": "从" },
          "end": { "name": "age_max", "hint": "到" }
        },
        { "type": "notice", "text": "{{follow_min}} ~ {{follow_max}}" }
      ]
    },
    { "type": "space", "height": 8 },
    {
      "type": "card",
      "children": [
        { "type": "text", "text": "自定义颜色", "style": { "fontWeight": "bold" } },
        {
          "type": "range",
          "label": "蓝色聚焦",
          "separator": "~",
          "variant": "box",
          "inputType": "digit",
          "style": { "focusColor": "#1565C0" },
          "start": { "name": "blue_min", "hint": "从" },
          "end": { "name": "blue_max", "hint": "到" }
        }
      ]
    }
  ]
}
