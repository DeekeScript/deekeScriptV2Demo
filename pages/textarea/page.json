        { "type": "textarea", "name": "bio", "label": "边框", "hint": "个人简介", "minLines": 4, "variant": "box", "style": { "radius": 8 } }
      ]
    },
    { "type": "space", "height": 8 },
    { "type": "textarea", "name": "plain", "hint": "请输入", "minLines": 3, "variant": "plain" }
