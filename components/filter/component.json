{
  "component": true,
  "id": "filter",
  "body": [
    { "type": "search", "name": "q", "hint": "搜任务名", "onChange": "onInput" },
    {
      "type": "row",
      "style": { "gap": 8 },
      "children": [
        { "type": "tag", "text": "全部", "onClick": "pickAll" },
