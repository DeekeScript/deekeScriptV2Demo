{
  "component": true,
  "id": "filter",
  "body": [
    { "type": "search", "name": "q", "hint": "搜任务名", "onChange": "onInput" },
    {
      "type": "row",
      "style": { "gap": 8 },
      "children": [
        { "type": "tag", "text": "全部", "onTap": "pickAll", "style": { "background": "{{allBg}}", "color": "{{allColor}}" } },
        { "type": "tag", "text": "进行中", "onTap": "pickRun", "style": { "background": "{{runBg}}", "color": "{{runColor}}" } },
        { "type": "tag", "text": "已完成", "onTap": "pickDone", "style": { "background": "{{doneBg}}", "color": "{{doneColor}}" } }
      ]
    },
    { "type": "notice", "text": "当前筛选：{{label}}" }
  ]
}
